# ---------------------------------------------------------------------------
# OmniRank environment template.
#
# Copy to `.env` (git-ignored) and fill in. Every variable below overrides the
# matching key in configs/*.yaml. The delimiter is a DOUBLE underscore:
#
#     OMNIRANK__<SECTION>__<KEY>=value
#
# Secrets MUST live here or in the real environment. They are never committed
# to YAML. See docs/architecture/component_contracts.md, "Configuration".
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
OMNIRANK__ENVIRONMENT=local
OMNIRANK__SEED=42

# --- Compute ---------------------------------------------------------------
# auto | cpu | mps | cuda.  `auto` resolves to mps on Apple Silicon, else cpu.
# CUDA is never selected by `auto`; request it explicitly on a GPU host.
OMNIRANK__DEVICE__PREFERRED=auto
OMNIRANK__DEVICE__ALLOW_CUDA=false

# --- Logging ---------------------------------------------------------------
OMNIRANK__LOGGING__LEVEL=INFO
# json | console
OMNIRANK__LOGGING__FORMAT=console

# --- Paths -----------------------------------------------------------------
OMNIRANK__PATHS__DATA_ROOT=data
OMNIRANK__PATHS__ARTIFACT_ROOT=artifacts

# --- PostgreSQL ------------------------------------------------------------
OMNIRANK__DATABASE__HOST=localhost
OMNIRANK__DATABASE__PORT=5432
OMNIRANK__DATABASE__NAME=omnirank
OMNIRANK__DATABASE__USER=omnirank
OMNIRANK__DATABASE__PASSWORD=change-me-locally

# --- Redis -----------------------------------------------------------------
OMNIRANK__REDIS__HOST=localhost
OMNIRANK__REDIS__PORT=6379
OMNIRANK__REDIS__DB=0
# Leave empty for a local, unauthenticated Redis.
OMNIRANK__REDIS__PASSWORD=

# --- API -------------------------------------------------------------------
OMNIRANK__API__HOST=127.0.0.1
OMNIRANK__API__PORT=8000
OMNIRANK__API__RELOAD=true
